# Copy to .env and fill in.

# OpenAI key used to generate draft replies.
OPENAI_API_KEY=sk-...

# Model used for draft generation. gpt-4o-mini is cheap + good.
OPENAI_MODEL=gpt-4o-mini

# Path to Google OAuth client secret JSON downloaded from Google Cloud Console.
# (Desktop App credentials are easiest.)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Where to cache the OAuth refresh token after first auth.
GOOGLE_TOKEN_FILE=token.json

# Optional: short description of you / your style, used by the model as a
# fallback when an account doesn't have its own accounts/<email>/profile.md.
# Example: "Krzysztof, software engineer. Reply concisely, friendly but direct,
# no greetings like 'I hope this finds you well'. Sign off with 'Kris'."
USER_PROFILE=

# Where per-account OAuth tokens and (optional) profile/knowledge files live.
AGENT_ACCOUNTS_DIR=accounts

# Gmail label applied to messages after a draft is created for them.
# Used as a skip marker so the agent doesn't re-draft the same email.
# Slashes create nested labels in Gmail (label "agent" with child "drafted").
AGENT_LABEL_NAME=agent/drafted

# --- travel_agent (optional) ---------------------------------------------
# Model used to extract structured offers from scraped travel pages.
# Defaults to OPENAI_MODEL above.
# TRAVEL_OPENAI_MODEL=gpt-4o-mini
# How many of the cheapest offers per destination to keep in the output.
# TRAVEL_MAX_OFFERS_PER_DEST=3
# Per-site cap on cleaned-text characters sent to the LLM.
# TRAVEL_MAX_TEXT_CHARS=18000
# Concurrent HTTP requests when scraping the 10 portals.
# TRAVEL_FETCH_CONCURRENCY=6
# Concurrent OpenAI extraction calls. Keep <= 4 on a free/tier-1
# account to stay under the 30k TPM limit for gpt-4o-mini.
# TRAVEL_EXTRACT_CONCURRENCY=4
# HTTP request timeout, seconds.
# TRAVEL_HTTP_TIMEOUT=20

# Recipients for the daily email digest (comma-separated).
# Defaults to andalath@gmail.com, goniaras@gmail.com if unset.
# TRAVEL_EMAIL_TO=andalath@gmail.com, goniaras@gmail.com
# Sender Gmail account (must already be authenticated via
# `python -m gmail_agent auth`).
# TRAVEL_EMAIL_FROM=andalath@gmail.com

# --- tech_news_agent (optional) ------------------------------------------
# Model used to extract headlines and draft LinkedIn posts.
# TECH_NEWS_OPENAI_MODEL=gpt-4o-mini
# Max stories kept per source / in the final ranked list.
# TECH_NEWS_MAX_STORIES_PER_SITE=10
# TECH_NEWS_MAX_TOP_STORIES=5
# Recipient for the daily LinkedIn draft email (comma-separated).
# TECH_NEWS_EMAIL_TO=andalath@gmail.com
# Sender Gmail account (must already be authenticated via gmail_agent auth).
# TECH_NEWS_EMAIL_FROM=andalath@gmail.com
# Path to author profile for personalized LinkedIn voice (optional).
# TECH_NEWS_AUTHOR_PROFILE=tech_news_agent/author_profile.md
# Generate a retro "World Retro news" illustration in each email (default on).
# TECH_NEWS_GENERATE_ILLUSTRATIONS=1
# TECH_NEWS_IMAGE_MODEL=gpt-image-1
# TECH_NEWS_IMAGE_SIZE=1024x1024

# --- morning_agent (optional) --------------------------------------------
# Model used to generate daily affirmations (falls back to curated text if
# OPENAI_API_KEY is missing or the API call fails).
# MORNING_OPENAI_MODEL=gpt-4o-mini
# Recipient for the daily poetry + affirmation email (comma-separated).
# MORNING_EMAIL_TO=katarzyna.dyngosz@gmail.com
# Sender Gmail account (must already be authenticated via gmail_agent auth).
# MORNING_EMAIL_FROM=andalath@gmail.com
